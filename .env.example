# Variables consumidas por docker-compose.yml para el stack completo
# (Postgres + backend + frontend). Copia este archivo a `.env` (ignorado
# por git) y ajusta los valores antes de un despliegue real — los
# defaults de abajo son solo para desarrollo local.

POSTGRES_DB=motocore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Cambiar SIEMPRE antes de un despliegue real. Program.cs emite una
# advertencia en el arranque si detecta que sigue siendo el valor de
# ejemplo y ASPNETCORE_ENVIRONMENT=Production.
JWT_SIGNING_KEY=MotoCore-Development-Signing-Key-Replace-In-Production-12345
