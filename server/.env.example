# Proyecto Supabase — las dos claves que el servidor necesita.
#
# Ambas estan en Project Settings -> API Keys.
#
# Si buscas «anon» y «service_role» y no las encuentras, es porque Supabase las
# renombro: son la publicable y la secreta respectivamente. El servidor usa solo
# los nombres actuales.

SUPABASE_URL=https://<tu-proyecto>.supabase.co

# Publicable. Es publica por diseno: el acceso lo deciden las politicas del
# motor, no el secreto de la clave. Es la misma que usa el navegador.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Secreta. **Salta las politicas RLS.** Nunca debe salir del servidor ni
# llegar al navegador (RNF-103). Su uso esta acotado a las siete excepciones
# que enumera src/lib/supabase.ts (ADR-008).
SUPABASE_SECRET_KEY=sb_secret_<...>

# Dev: permite iniciar sesion sin confirmar el correo, util porque no hay
# proveedor SMTP configurado. En produccion, 'false'.
AUTH_AUTO_CONFIRM_EMAIL=true

# Origenes de navegador admitidos, separados por comas: SOLO los del cliente
# web de este entorno (Requisitos, seccion 5). Sin valor, se admite el del
# servidor de desarrollo (http://localhost:5173). En staging y produccion hay
# que declarar el dominio del cliente, porque un origen no declarado no recibe
# la cabecera de CORS y el navegador bloquea la respuesta.
CORS_ALLOWED_ORIGINS=http://localhost:5173

PORT=8787

# Solo para `npm run db:migrate` y `npm run db:verify` (scripts/): conexion
# directa a Postgres, no a PostgREST. Esta en Project Settings -> Database ->
# Connection string -> URI. La API en tiempo de ejecucion NUNCA la usa —
# `lib/supabase.ts` habla siempre a traves de PostgREST, con las dos claves de
# arriba.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ---------------------------------------------------------------------------
# NO hace falta la URL del JWKS. El servidor verifica la credencial llamando a
# la API de Auth (`auth.getUser`), no comprobando la firma localmente. Si algun
# dia se pasara a verificacion local —que ahorraria una llamada de red por
# peticion— haria falta anadirla, y seria un cambio a documentar en ADR-004.
