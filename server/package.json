{
  "name": "motocore-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MotoCore backend — Node/TypeScript API (Hono) sobre Supabase, con multitenancy estilo ERP.",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit test/contract",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:verify": "tsx scripts/verify-schema.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@supabase/supabase-js": "^2.47.10",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
